# Synology/NAS deployment settings
# Set NAS_HOST to the NAS LAN IP or hostname used by your browser.
NAS_HOST=192.168.1.10
NAS_SCHEME=http
FRONTEND_PORT=3100
WORKSPACE_DIR=/volume1/docker/agenticseek/workspace

# Generate a long random value for SearXNG.
SEARXNG_SECRET_KEY=change-me

# LLM provider keys. Only populate the providers you actually use.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
HUGGINGFACE_API_KEY=
DSK_DEEPSEEK_API_KEY=
