FROM node:18 AS build

WORKDIR /app

COPY frontend/agentic-seek-front/package.json frontend/agentic-seek-front/package-lock.json ./
RUN npm ci

COPY frontend/agentic-seek-front/ ./

# Browser requests use the same NAS origin. Nginx proxies /api to the
# backend container, so backend port 7777 never needs to be published.
ENV REACT_APP_BACKEND_URL=/api
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/synology/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80
